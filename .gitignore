# ── Secrets & Credentials (Strict No-Commit Policy) ──────────
.env
*.env
.env.*
secrets.yaml
*.pem
*.key
*credentials*.json

# ── Scratch / intermediate / local-only rig & video files ─────
assets/rigs/*.log
assets/rigs/*.blend
assets/rigs/*.glb
assets/rigs/erika_archer.fbx
assets/rigs/*_raw.fbx
assets/rigs/*_test.fbx
assets/rigs/*_clean.fbx
assets/rigs/*_clean.png
assets/rigs/attractor_mechanic.fbx
assets/rigs/attractor_mechanic.png
assets/rigs/*.fbm/
assets/video/gemini_generated_video_*.mp4
assets/video/mechanic_dance_fullview.mp4

# ── Auto-downloaded inference weights ────────────────────────
weights/**
!weights/.gitkeep

# ── Run outputs ──────────────────────────────────────────────
outputs/**
!outputs/.gitkeep

# ── Python & caches ──────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
build/
dist/

# ── OS / editor / local workspace configs ────────────────────
:memory:.ses
.DS_Store
Thumbs.db
.agent/
.agents/
scratch/
GEMINI.md
PROJECT.md

# AntiCrow local data
.anticrow/
